{
  "name": "deujo",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for the Deujo static Tailwind stylesheet. No app runtime dependency.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./assets/css/tailwind-input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c ./tailwind.config.cjs -i ./assets/css/tailwind-input.css -o ./assets/css/tailwind.css --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tailwindcss": "3.4.19"
  }
}
